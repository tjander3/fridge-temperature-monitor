# Copy this file to .env. The real .env is ignored by Git.
NOTIFIER_POLL_SECONDS=30
NOTIFY_DASHBOARD_URL=http://192.168.1.50:8080
# Generate a long random value; required by the hidden ?admin=1 settings page.
ADMIN_API_TOKEN=replace-with-a-long-random-token

# Email through Gmail SMTP. Use a Google app password, not your account password.
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=your-address@gmail.com
SMTP_APP_PASSWORD=replace-with-a-16-character-app-password
NOTIFY_EMAIL_FROM=your-address@gmail.com
NOTIFY_EMAIL_TO=your-address@gmail.com
